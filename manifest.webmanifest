{
  "name": "Rueda de Color",
  "short_name": "Rueda",
  "description": "Rueda de color, armonías, paletas y herramientas para artistas y diseñadores.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0E1116",
  "theme_color": "#0E1116",
  "icons": [
    { "src": "icon180.png", "sizes": "180x180", "type": "image/png", "purpose": "any" },
    { "src": "icon192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "share_target": {
    "action": "./?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "image", "accept": ["image/*"] }
      ]
    }
  },
  "shortcuts": [
    { "name": "Paletas", "short_name": "Paletas", "url": "./?tab=pal" },
    { "name": "Herramientas", "short_name": "Herram.", "url": "./?tab=tools" },
    { "name": "Estudiar", "short_name": "Estudiar", "url": "./?tab=study" },
    { "name": "Rueda", "short_name": "Rueda", "url": "./?tab=wheel" }
  ]
}
